{
    "name": "tv-pc",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc && vite build",
        "preview": "vite preview",
        "tauri": "tauri",
        "check:format": "prettier --check .",
        "check:lint": "eslint src",
        "check:tsc": "tsc --noEmit --pretty",
